{
  "name": "phaser-web-template",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:standalone": "vite --host 0.0.0.0 --mode standalone",
    "dev:crazygames": "vite --host 0.0.0.0 --mode crazygames",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:standalone": "npm run typecheck && vite build --mode standalone",
    "build:crazygames": "npm run typecheck && vite build --mode crazygames",
    "build:verify": "vite build --mode crazygames --outDir test-results/builds/check/crazygames && vite build --mode standalone --outDir test-results/builds/check/standalone",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:standalone": "playwright test --config playwright.standalone.config.ts",
    "test:sdk": "playwright test --config playwright.sdk.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run test && npm run typecheck && npm run build:verify"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
